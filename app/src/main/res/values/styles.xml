<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A key that fills its GridLayout cell. -->
    <style name="Widget.SciCalc.Key" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">@dimen/key_margin</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/key_text_digit</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHighest</item>
        <item name="cornerRadius">@dimen/key_corner</item>
    </style>

    <style name="Widget.SciCalc.Key.Function">
        <item name="android:textSize">@dimen/key_text_function</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
    </style>

    <style name="Widget.SciCalc.Key.Toggle">
        <item name="android:textSize">@dimen/key_text_function</item>
        <item name="android:textColor">@color/key_toggle_text</item>
        <item name="backgroundTint">@color/key_toggle_background</item>
    </style>

    <style name="Widget.SciCalc.Key.Operator">
        <item name="android:textSize">@dimen/key_text_operator</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
    </style>

    <style name="Widget.SciCalc.Key.Clear">
        <item name="android:textSize">@dimen/key_text_function</item>
        <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
        <item name="backgroundTint">?attr/colorTertiaryContainer</item>
    </style>

    <style name="Widget.SciCalc.Key.Equals">
        <item name="android:textSize">@dimen/key_text_operator</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.SciCalc.Indicator" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
