<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/display_padding"
    android:paddingBottom="@dimen/display_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/angle_indicator"
            style="@style/TextAppearance.SciCalc.Indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/angle_degrees" />

        <TextView
            android:id="@+id/inverse_indicator"
            style="@style/TextAppearance.SciCalc.Indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/key_inverse"
            android:visibility="invisible" />
    </LinearLayout>

    <TextView
        android:id="@+id/evaluated_expression"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="start"
        android:gravity="end|bottom"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textDirection="ltr"
        android:textSize="@dimen/display_secondary_text"
        tools:text="2×sin(30)+1 =" />

    <TextView
        android:id="@+id/expression"
        android:layout_width="match_parent"
        android:layout_height="@dimen/display_expression_height"
        android:ellipsize="start"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textDirection="ltr"
        app:autoSizeMaxTextSize="@dimen/display_expression_max_text"
        app:autoSizeMinTextSize="20sp"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        tools:text="2" />

    <TextView
        android:id="@+id/result_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="2"
        android:minLines="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/display_secondary_text"
        tools:text="= 2" />

</LinearLayout>
